# CRT86 — Decentralized CRT Terminal on Solana
# Copy to .env.local and fill in. NEVER commit .env.local.
# Public repo: https://github.com/CTR86/crt86 — no secrets are committed.

# --- Solana RPC, mainnet (StonkFun / Ember / wallet) ---
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
VITE_SOLANA_CLUSTER=mainnet-beta

# --- Devnet RPC for DIRECT testing ---
# Empty = derived from the Helius mainnet URL (mainnet. -> devnet.),
# otherwise public devnet. Set explicitly only if derivation fails.
VITE_SOLANA_DEVNET_RPC_URL=

# --- DIRECT engine: existing DBC pool-config per quote (devnet while testing) ---
# Deploy one config per quote via the DBC SDK partner.createConfig, then paste
# its address here. Empty = honest NOT-CONFIGURED state, no fake pools.
VITE_METEORA_DBC_CONFIG_SOL=
VITE_METEORA_DBC_CONFIG_USDC=
VITE_METEORA_DBC_CONFIG_DEFAULT=

# --- Platform fee policy: launchers pay ZERO to us ---
# Keep at 0. Launchers pay only Solana rent + tx fees and the Meteora
# protocol cut. Do NOT raise without an explicit policy change.
VITE_PLATFORM_FEE_BPS=0
VITE_PLATFORM_FEE_RECIPIENT=

# --- DIRECT engine defaults ---
VITE_DIRECT_DEFAULT_SLIPPAGE_BPS=100

# --- STOCK.EXE — Backpack Exchange (tokenized US stocks) ---
# Public tape (securities / sessions / tickers) needs no key.
# Trading is ED25519-signed server-side (RFQ during session hours).
# Put these in .env.local and Vercel env — NEVER as VITE_ and NEVER commit.
BACKPACK_API_KEY=
BACKPACK_API_SECRET=
BACKPACK_API_NAME=crt2
# Optional operator gate: when set, every /api/bp op except status
# requires the matching x-operator-token header (the operator pastes it
# once in STOCK.EXE). Unset = open (single-operator default).

# --- Relay Bridge (optional) ---
# Public Relay API works without a key (rate-limited). Add your own
# Relay dashboard key to raise limits. Do NOT commit a real key.
VITE_RELAY_API_KEY=

# --- PARKED: Jupiter Perps engine (Solana mainnet, no live route) ---
# The parked reader (src/lib/perp) works with public APIs + RPC out of the box.
# Live PERP.EXE runs on Hyperliquid + Aster (no env needed). These remain
# for a future Jupiter-perps revival only.
#
# Public endpoints (no key required today). Override only if Jupiter
# rotates them or you proxy through your own backend.
VITE_JUPITER_PERPS_API_URL=https://perps-api.jup.ag
VITE_JUP_PRICE_API_URL=https://price.jup.ag
# Jupiter Developer Platform key (https://developers.jup.ag/portal).
# JUP.EXE prefers the server-side key below via the /api/jup proxy and
# only falls back to this browser key for local dev without the proxy.
VITE_JUPITER_API_KEY=
# --- JUP.EXE — Jupiter Swap (Solana mainnet) ---
# Server-side key for the /api/jup proxy (Vercel env + .env.local).
# The browser never sees this value — /api/jup.mjs injects it as x-api-key.
# Get one at https://developers.jup.ag/portal. Quote + search + price work
# through the proxy; direct api.jup.ag fallback uses VITE_JUPITER_API_KEY.
JUPITER_API_KEY=
# Optional overrides if Jupiter rotates gateways (defaults shown):
# VITE_JUP_SWAP_API_URL=https://api.jup.ag/swap/v2
# VITE_JUP_TOKENS_API_URL=https://api.jup.ag/tokens/v2
# VITE_JUP_PRICE_API_URL=https://api.jup.ag/price/v3
# Solana RPC for perps reads + Position PDA scans + tx simulation.
# Defaults to VITE_SOLANA_RPC_URL, then public fallback.
VITE_PERP_RPC_URL=
# On-chain program + pool. Defaults are mainnet Jupiter Perps.
VITE_JUP_PERPS_PROGRAM_ID=PERPHjGBqRHArX4DySjwM6UJHiR3sWAatqfdBS2qQJu
VITE_JUP_POOL_PUBKEY=5BUwFW4nRbftYTDMbgSyAoCjRmVdJiuPACx2A9GPeDCW
# Custody pubkeys — REQUIRED for trading. Find them in JLP info or
# on Solscan (custody accounts owned by the perps program). Without
# these, PERP.EXE shows a read-only warning instead of faking fills.
VITE_JUP_CUSTODY_SOL=7xS2gz2bTp3fwCC7knJvUWTEU9Tycczu6VhJYKgi1wdz
VITE_JUP_CUSTODY_ETH=AQCGyheWPLeo6Qp9WpYS9m3Qj479t7R636N9ey1rEjEn
VITE_JUP_CUSTODY_WBTC=5Pv3gM9JrFFH883SWAhvJC9RPYmo8UNxuFtv5bMMALkm
# USDC collateral custody for shorts (shared). Default below is the
# mainnet USDC custody; override only if Jupiter rotates it.
VITE_JUP_COLLATERAL_CUSTODY_USDC=G18jKKXQwBbrHeiK3C9MRXhkHsLHf7XgCSisykV46EZa

# --- LEND.EXE — Jupiter Lend (Earn + Borrow, Solana mainnet) ---
# Same Developer Platform key as JUP.EXE — the Lend gateway
# (https://api.jup.ag/lend/v1) accepts the same x-api-key.
# Server-side key for the /api/lend proxy (Vercel env + .env.local).
# The browser never sees this value — /api/lend.mjs injects it.
# Direct api.jup.ag fallback uses VITE_JUPITER_API_KEY (local dev only).
# No new secret is required if JUPITER_API_KEY is already set.
# Optional override if Jupiter rotates the Lend gateway:
# VITE_JUPITER_LEND_API_URL=https://api.jup.ag/lend/v1

# --- UNISWAP.EXE — Uniswap Trading API (EVM: BNB/ETH/Base/Arb/Polygon/Avax) ---
# API-first: best-price CLASSIC routing (V2/V3/V4, simulated) via the
# server proxy, with automatic on-chain V3 fallback (no key needed).
# Key dashboard: https://developers.uniswap.org → API keys.
# Server-side only (Vercel env + .env.local, NEVER as VITE_ —
# /api/uniswap.mjs injects it as x-api-key). Gateway defaults to the
# official endpoint; override only if Uniswap rotates it.
UNISWAP_API_KEY=
# UNISWAP_API_BASE=https://trade-api.gateway.uniswap.org/v1
# Optional public-RPC overrides (one per chain, browser-safe):
# VITE_BSC_RPC_URL=
# VITE_ETH_RPC_URL=
# VITE_BASE_RPC_URL=
# VITE_ARBITRUM_RPC_URL=
# VITE_POLYGON_RPC_URL=
# VITE_AVALANCHE_RPC_URL=

# --- PANCAKE.EXE — PancakeSwap V2 (EVM: BNB Chain + ETH/Base/Arbitrum) ---
# Same deal as UNISWAP.EXE: on-chain today (V2 router getAmountsOut),
# no key needed. Future credentialed routing API goes here server-side.
PANCAKESWAP_API_KEY=
PANCAKESWAP_API_BASE=

# --- PREDICT.EXE — Polymarket + Kalshi (mounted, not invented) ---
# Polymarket: CLOB on Polygon; key material is per-user and pasted in the
# window itself (private key NEVER leaves the browser, HMAC handled by
# the official @polymarket/clob-client). Optional pinned market:
# VITE_POLYMARKET_MARKET_SLUG=will-bitcoin-hit-100000-in-2025
# Kalshi: RSA key ID + PEM pasted in-window (session-only default, never
# committed). Optional pinned market:
# VITE_KALSHI_MARKET_TICKER=KXBTC-25DEC31-B100000
# Signing for Kalshi is server-side per-request via /api/kalshi.mjs
# (browser CORS forbids KALSHI-* headers) — creds never stored server-side.
# VITE_POLYMARKET_MARKET_SLUG=
# VITE_KALSHI_MARKET_TICKER=
